<style>
  .positioning-statement {
    background: #F5EFEA;
    padding: 20px 20px 24px;
  }

  .positioning-statement__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 60px;
  }

  .positioning-statement__illustration {
    flex: 0 0 auto;
    width: 190px;
    height: auto;
    display: block;
  }

  .positioning-statement__text {
    flex: 1 1 auto;
    text-align: center;
  }

  .positioning-statement__headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.4rem, 4.8vw, 3.8rem);
    font-weight: 700;
    font-style: italic;
    color: #2E221C;
    margin: 0 auto;
    max-width: 840px;
    letter-spacing: 0.01em;
    line-height: 1.35;
  }

  .positioning-statement__subline-text {
    font-family: 'Montserrat', 'Playfair Display', serif;
    font-size: clamp(1.4rem, 2.2vw, 1.8rem);
    font-weight: 500;
    color: #1F3F26;
    margin: 14px auto 0;
    max-width: 840px;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  @media screen and (max-width: 989px) {
    .positioning-statement {
      padding: 18px 20px 22px;
    }

    .positioning-statement__inner {
      gap: 20px;
      padding: 0 40px;
    }

    .positioning-statement__illustration {
      width: 130px;
    }
  }

  @media screen and (max-width: 749px) {
    .positioning-statement {
      padding: 14px 16px 18px;
    }

    .positioning-statement__inner {
      flex-direction: row;
      align-items: center;
      gap: 12px;
      padding: 0 20px;
    }

    .positioning-statement__illustration {
      width: 80px;
    }

    .positioning-statement__headline {
      font-size: clamp(1.5rem, 5vw, 1.85rem);
      line-height: 1.4;
      max-width: 100%;
    }

    .positioning-statement__subline-text {
      font-size: 1.15rem;
      margin-top: 8px;
    }
  }

  @media screen and (max-width: 479px) {
    .positioning-statement__illustration {
      width: 60px;
    }

    .positioning-statement__headline {
      font-size: 1.4rem;
    }

    .positioning-statement__subline-text {
      font-size: 0.95rem;
    }
  }
</style>

<section class="positioning-statement">
  <div class="positioning-statement__inner">
    <img
      src="{{ 'illustration-water-tower.png' | asset_url }}"
      alt="Brooklyn water tower with cacao leaves"
      class="positioning-statement__illustration positioning-statement__illustration--left"
      loading="lazy"
      width="190"
    >
    <div class="positioning-statement__text">
      <h2 class="positioning-statement__headline">{{ section.settings.headline | escape }}</h2>
      {%- if section.settings.subline != blank -%}
        <p class="positioning-statement__subline-text">{{ section.settings.subline | escape }}</p>
      {%- endif -%}
    </div>
    <img
      src="{{ 'illustration-cacao-branch.png' | asset_url }}"
      alt="Cacao branch with pods and flowers"
      class="positioning-statement__illustration positioning-statement__illustration--right"
      loading="lazy"
      width="190"
    >
  </div>
</section>

{% schema %}
{
  "name": "Positioning Statement",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Where flavor begins with cacao"
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Subline",
      "default": "Rooted in cacao. Handcrafted in Brooklyn."
    }
  ],
  "presets": [
    {
      "name": "Positioning Statement"
    }
  ]
}
{% endschema %}
