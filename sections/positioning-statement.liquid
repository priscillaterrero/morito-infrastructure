<style>
  .positioning-statement {
    background: #F5EFEA;
    padding: 24px 20px 28px;
  }

  .positioning-statement__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 36px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .positioning-statement__illustration {
    flex: 0 0 auto;
    width: 140px;
    height: auto;
    display: block;
    opacity: 0.92;
  }

  .positioning-statement__text {
    flex: 0 1 auto;
    text-align: left;
  }

  .positioning-statement__headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    font-style: italic;
    color: #2E221C;
    margin: 0;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  .positioning-statement__subline-text {
    font-family: 'Montserrat', 'Playfair Display', serif;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    font-weight: 500;
    color: #1F3F26;
    margin: 10px 0 0;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  @media screen and (max-width: 989px) {
    .positioning-statement {
      padding: 20px 20px 24px;
    }

    .positioning-statement__inner {
      gap: 24px;
      padding: 0 32px;
    }

    .positioning-statement__illustration {
      width: 110px;
    }
  }

  @media screen and (max-width: 749px) {
    .positioning-statement {
      padding: 18px 16px 20px;
    }

    .positioning-statement__inner {
      flex-direction: row;
      align-items: center;
      gap: 16px;
      padding: 0 16px;
    }

    .positioning-statement__illustration {
      width: 80px;
    }

    .positioning-statement__headline {
      font-size: clamp(1.3rem, 4.5vw, 1.7rem);
    }

    .positioning-statement__subline-text {
      font-size: 0.95rem;
      margin-top: 6px;
    }
  }

  @media screen and (max-width: 479px) {
    .positioning-statement__illustration {
      width: 64px;
    }

    .positioning-statement__headline {
      font-size: 1.25rem;
    }

    .positioning-statement__subline-text {
      font-size: 0.85rem;
    }
  }
</style>

<section class="positioning-statement">
  <div class="positioning-statement__inner">
    <img
      src="{{ 'illustration-water-tower.png' | asset_url }}"
      alt="Brooklyn water tower"
      class="positioning-statement__illustration"
      loading="lazy"
      width="140"
    >
    <div class="positioning-statement__text">
      {%- if section.settings.headline != blank -%}
        <h2 class="positioning-statement__headline">{{ section.settings.headline | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subline != blank -%}
        <p class="positioning-statement__subline-text">{{ section.settings.subline | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Positioning Statement",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Best Sellers / Perfect Gifting"
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Subline",
      "default": "Rooted in cacao. Handcrafted in Brooklyn."
    }
  ],
  "presets": [
    {
      "name": "Positioning Statement"
    }
  ]
}
{% endschema %}
