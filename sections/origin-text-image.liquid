<div class="container about-origin-main">
<!--   tHIRD IMAGE-TEXT -->
{% if section.settings.text1 %}
  <div class="only-text-main">
    <div class="text-center">
      <h2 data-pf-type="Heading" class="content">
        <span class="content-main">{{section.settings.text1 | newline_to_br}}</span>
       </h2>
    </div>
  </div>
  {% endif %}

<!--   Fourt section -->
{% for block in section.blocks  %}
  {% if  block.settings.image != blank %}
  <div class="image-caco-main">
    <div class="value-driven">
      <div  class="supply-img">
        <img src={{ block.settings.image| img_url:'master' }} alt="Morito story" loading="lazy" class="image-ccao">
      </div>
    </div>
  </div>
  {% endif %}
  
<!--  five section  -->
{% if block.settings.content != blank %}
    <div class="our-caco">
      <div class="pf-c-our-caco">
       {{ block.settings.content }}
        </div>
    </div>
    {% endif %}
    {% endfor %}

{% if section.settings.show_hbk_badge %}
  <div class="hbk-badge-footer">
    {% if section.settings.hbk_link != blank %}
      <a href="{{ section.settings.hbk_link }}" target="_blank" rel="noopener" aria-label="Hot Bread Kitchen">
        <img src="{{ 'incubated-at-hbk.png' | asset_url }}" alt="Incubated at Hot Bread Kitchen" class="hbk-badge-img" loading="lazy">
      </a>
    {% else %}
      <img src="{{ 'incubated-at-hbk.png' | asset_url }}" alt="Incubated at Hot Bread Kitchen" class="hbk-badge-img" loading="lazy">
    {% endif %}
    {% if section.settings.hbk_text != blank %}
      <div class="hbk-badge-text">{{ section.settings.hbk_text }}</div>
    {% endif %}
  </div>
{% endif %}
</div>


{% schema %}
  {
    "name": "origin-text-image",
    "settings": [
    {
      "type": "textarea",
      "id": "text1",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Hot Bread Kitchen Badge"
    },
    {
      "type": "checkbox",
      "id": "show_hbk_badge",
      "label": "Show HBK badge at bottom",
      "default": false
    },
    {
      "type": "url",
      "id": "hbk_link",
      "label": "HBK link"
    },
    {
      "type": "richtext",
      "id": "hbk_text",
      "label": "HBK text"
    }
    ],
        "blocks": [
      {
        "type": "image-text",
        "name": "Image with Text",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "richtext",
            "id": "content",
            "label": "Content"
          }
      	]
   	  }
    ]
  }
{% endschema %}

{% stylesheet %}
.hbk-badge-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 20px;
  margin: 40px auto 60px;
  padding: 0 20px;
  max-width: 640px;
}
.hbk-badge-img {
  width: 140px;
  height: auto;
  display: block;
}
.hbk-badge-text {
  font-size: 15px;
  line-height: 1.6;
  color: inherit;
}
.hbk-badge-text a {
  text-decoration: underline;
  color: inherit;
}
@media (max-width: 749px) {
  .hbk-badge-img { width: 120px; }
  .hbk-badge-text { font-size: 14px; }
}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}